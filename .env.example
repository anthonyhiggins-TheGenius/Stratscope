# Database (docker compose up -d db starts one that matches this)
DATABASE_URL=postgresql://stratscope:stratscope@localhost:5432/stratscope

# First admin, created by `npm run db:seed` when no users exist
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-please-12

SESSION_HOURS=8

# AI provider: none | anthropic | bedrock | openai_compat
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MODEL_COMPLEX=claude-sonnet-5-5
# bedrock: AWS_REGION and the exact model or inference profile ID. Credentials come from the AWS role.
# AWS_REGION=us-east-1
# openai_compat (for example Ollama or vLLM that you host):
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
AI_MAX_TOKENS=12000
AI_TIMEOUT_SECONDS=280
AI_RATE_PER_HOUR=60
